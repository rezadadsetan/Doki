<!-- Doki main window. ASCII only: every visible static text comes from i18n via Tag="key" (see Ui.ps1 Update-WkTagged).
     Screens are Grids in the same cell; Ui.ps1 toggles their Visibility. No events in XAML (wired in Ui.ps1).
     2.6.0: colours are design tokens (C.*) defined once below (D-035); sizes that change in compact mode are DynamicResources. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Doki" Width="1100" Height="740" MinWidth="800" MinHeight="540"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Tahoma" FontSize="15"
        Background="{DynamicResource C.Bg}" Foreground="{DynamicResource C.Text}" UseLayoutRounding="True">
  <Window.Resources>
    <!-- Design tokens: the only place colours are defined (Ui.ps1 Get-WkBrush 'C.Name'). -->
    <SolidColorBrush x:Key="C.Bg" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="C.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="C.White" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="C.Text" Color="#252A3C"/>
    <SolidColorBrush x:Key="C.Muted" Color="#6B7080"/>
    <SolidColorBrush x:Key="C.Line" Color="#EBECF2"/>
    <SolidColorBrush x:Key="C.Input" Color="#DADCE5"/>
    <SolidColorBrush x:Key="C.Accent" Color="#028EF9"/>
    <SolidColorBrush x:Key="C.Brand" Color="#06D170"/>
    <SolidColorBrush x:Key="C.BrandHover" Color="#9FE8C4"/>
    <SolidColorBrush x:Key="C.Teal" Color="#0E8F86"/>
    <SolidColorBrush x:Key="C.TealLine" Color="#BFE3DF"/>
    <SolidColorBrush x:Key="C.Orange" Color="#FF661F"/>
    <SolidColorBrush x:Key="C.Green.Fill" Color="#EBFBF4"/>
    <SolidColorBrush x:Key="C.Green.Border" Color="#BDEFD5"/>
    <SolidColorBrush x:Key="C.Green.Fg" Color="#04A85A"/>
    <SolidColorBrush x:Key="C.Amber.Fill" Color="#FFF1E8"/>
    <SolidColorBrush x:Key="C.Amber.Border" Color="#FFD2B8"/>
    <SolidColorBrush x:Key="C.Amber.Fg" Color="#E0560F"/>
    <SolidColorBrush x:Key="C.Amber.Text" Color="#B5470F"/>
    <SolidColorBrush x:Key="C.Red.Fill" Color="#FDECEC"/>
    <SolidColorBrush x:Key="C.Red.Border" Color="#F6C2C4"/>
    <SolidColorBrush x:Key="C.Red.Fg" Color="#E5484D"/>
    <SolidColorBrush x:Key="C.Reject" Color="#8B1E2D"/>
    <SolidColorBrush x:Key="C.Grey.Fill" Color="#F4F5F8"/>
    <SolidColorBrush x:Key="C.Grey.Border" Color="#EBECF2"/>
    <SolidColorBrush x:Key="C.Grey.Fg" Color="#6B7080"/>
    <SolidColorBrush x:Key="C.Busy.Fg" Color="#028EF9"/>
    <SolidColorBrush x:Key="C.Mic.Track" Color="#E3E5EC"/>
    <SolidColorBrush x:Key="C.Mic.Idle" Color="#9AA0B4"/>

    <!-- Sizes switched by Ui.ps1 Update-WkCompact (small screens). -->
    <sys:Double x:Key="H1Size">26</sys:Double>
    <sys:Double x:Key="PrimaryHeight">56</sys:Double>
    <Thickness x:Key="CardPad">20</Thickness>
    <Thickness x:Key="CardMargin">8</Thickness>

    <Style x:Key="BtnBase" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background" Value="{StaticResource C.Brand}"/>
      <Setter Property="Foreground" Value="{StaticResource C.White}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Height" Value="{DynamicResource PrimaryHeight}"/>
      <Setter Property="Padding" Value="32,0"/>
    </Style>
    <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background" Value="{StaticResource C.Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource C.Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource C.Input}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background" Value="{StaticResource C.Red.Fg}"/>
      <Setter Property="Foreground" Value="{StaticResource C.White}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Height" Value="{DynamicResource PrimaryHeight}"/>
      <Setter Property="Padding" Value="32,0"/>
    </Style>
    <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource C.Accent}"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="8,0"/>
    </Style>
    <!-- Flat clickable surface (stepper steps, summary chips): background/border come from the button itself. -->
    <Style x:Key="Flat" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.5"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="{DynamicResource CardPad}"/>
      <Setter Property="Margin" Value="{DynamicResource CardMargin}"/>
      <Setter Property="Background" Value="{StaticResource C.Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource C.Line}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="46"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="{StaticResource C.Input}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource C.Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource H1Size}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="8,0,8,8"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Background" Value="{StaticResource C.Grey.Fill}"/>
    </Style>
    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14,5"/>
      <Setter Property="Margin" Value="12,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{StaticResource C.Grey.Fill}"/>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource C.Brand}"/>
      <Setter Property="Background" Value="{StaticResource C.Line}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top bar -->
    <Border Grid.Row="0" Background="{StaticResource C.Surface}" BorderBrush="{StaticResource C.Line}" BorderThickness="0,0,0,1" Padding="20,10">
      <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" FlowDirection="LeftToRight">
          <Image x:Name="TopLogoImg" Width="34" Height="34" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Doki" FontSize="24" FontWeight="Bold" Foreground="{StaticResource C.Teal}" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="BtnLang" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Tag="lang.toggle" Height="36" FontSize="14" Padding="14,0"/>
        <Button x:Name="BtnDokiMute" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Height="36" Width="36" Padding="0" Margin="0,0,8,0">
          <Image x:Name="DokiMuteImg" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Button>
        <Button x:Name="BtnAbout" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Content="i" FontWeight="Bold" Height="36" Width="36" FontSize="16" Padding="0" Margin="0,0,8,0"/>
        <Border x:Name="RoleBox" DockPanel.Dock="Right" Background="{StaticResource C.Green.Fill}" CornerRadius="14" Padding="14,6" Margin="12,0" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock x:Name="RoleLine" FontWeight="SemiBold" Foreground="{StaticResource C.Green.Fg}"/>
        </Border>
        <TextBlock x:Name="DeviceLine" VerticalAlignment="Center" Margin="24,0" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
      </DockPanel>
    </Border>

    <!-- No-admin banner -->
    <Border x:Name="BannerNoAdmin" Grid.Row="1" Background="{StaticResource C.Amber.Fill}" Padding="20,8" Visibility="Collapsed">
      <TextBlock Tag="banner.noAdmin" Foreground="{StaticResource C.Amber.Text}" TextWrapping="Wrap"/>
    </Border>

    <!-- 2.6.0 (#8): five-step progress bar; shown on Checks / Stress / Checklist / Report. -->
    <Border x:Name="StepperBar" Grid.Row="2" Background="{StaticResource C.Surface}" BorderBrush="{StaticResource C.Line}" BorderThickness="0,0,0,1" Padding="12,6" Visibility="Collapsed">
      <UniformGrid Rows="1" Columns="5">
        <Button x:Name="StepHome" Style="{StaticResource Flat}" Margin="4,0">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="StepHomeDot" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center"><TextBlock x:Name="StepHomeNum" Text="1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="8,0" VerticalAlignment="Center">
              <TextBlock x:Name="StepHomeText" Tag="step.home" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="StepHomeSub" FontSize="12" Foreground="{StaticResource C.Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
            </StackPanel>
          </StackPanel>
        </Button>
        <Button x:Name="StepChecks" Style="{StaticResource Flat}" Margin="4,0">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="StepChecksDot" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center"><TextBlock x:Name="StepChecksNum" Text="2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="8,0" VerticalAlignment="Center">
              <TextBlock x:Name="StepChecksText" Tag="step.checks" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="StepChecksSub" FontSize="12" Foreground="{StaticResource C.Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
            </StackPanel>
          </StackPanel>
        </Button>
        <Button x:Name="StepStress" Style="{StaticResource Flat}" Margin="4,0">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="StepStressDot" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center"><TextBlock x:Name="StepStressNum" Text="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="8,0" VerticalAlignment="Center">
              <TextBlock x:Name="StepStressText" Tag="step.stress" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="StepStressSub" FontSize="12" Foreground="{StaticResource C.Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
            </StackPanel>
          </StackPanel>
        </Button>
        <Button x:Name="StepManual" Style="{StaticResource Flat}" Margin="4,0">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="StepManualDot" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center"><TextBlock x:Name="StepManualNum" Text="4" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="8,0" VerticalAlignment="Center">
              <TextBlock x:Name="StepManualText" Tag="step.manual" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="StepManualSub" FontSize="12" Foreground="{StaticResource C.Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
            </StackPanel>
          </StackPanel>
        </Button>
        <Button x:Name="StepReport" Style="{StaticResource Flat}" Margin="4,0">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="StepReportDot" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center"><TextBlock x:Name="StepReportNum" Text="5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="8,0" VerticalAlignment="Center">
              <TextBlock x:Name="StepReportText" Tag="step.report" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="StepReportSub" FontSize="12" Foreground="{StaticResource C.Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
            </StackPanel>
          </StackPanel>
        </Button>
      </UniformGrid>
    </Border>

    <!-- Screens. Column 0 = reserved side column for the compact Doki (start side, opposite the primary buttons; Phase 8). -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid x:Name="DokiSideHost" Grid.Column="0" Width="150" Margin="8,8,0,12" VerticalAlignment="Stretch" Visibility="Collapsed"/>
    <Grid Grid.Column="1">

      <!-- 1. Home: login card + the large Doki beside it (end side) -->
      <Grid x:Name="ScreenHome">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid x:Name="DokiHomeHost" Grid.Column="1" Width="250" Margin="4,0,0,8" VerticalAlignment="Bottom">
          <!-- DokiPanel is moved between DokiHomeHost and DokiSideHost by Ui.ps1 (Move-DokiTo). -->
          <StackPanel x:Name="DokiPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <StackPanel x:Name="DokiBubble" Margin="0,0,0,2">
              <Border x:Name="DokiBubbleBox" Background="{StaticResource C.Surface}" BorderBrush="{StaticResource C.Line}" BorderThickness="2" CornerRadius="16" Padding="14,10" MaxWidth="300">
                <TextBox x:Name="DokiBubbleText" IsReadOnly="True" IsTabStop="False" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                         FontSize="15" Height="Auto" MinHeight="0" Padding="0" VerticalContentAlignment="Top" Foreground="{StaticResource C.Text}" Cursor="Arrow"/>
              </Border>
              <Path Data="M0,0 L9,12 L18,0" Fill="{StaticResource C.Surface}" Stroke="{StaticResource C.Line}" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
            </StackPanel>
            <Grid x:Name="DokiFlip" FlowDirection="LeftToRight" Height="220">
              <Grid x:Name="DokiFigure" Background="Transparent">
                <Image x:Name="DokiImgA" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Image x:Name="DokiImgB" Stretch="Uniform" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
            </Grid>
          </StackPanel>
        </Grid>
        <Border Grid.Column="0" Style="{StaticResource Card}" Width="580" VerticalAlignment="Center" Padding="36,28" Margin="0">
          <StackPanel>
            <TextBlock Tag="home.title" FontSize="30" FontWeight="Bold"/>
            <TextBlock Tag="login.pick" Style="{StaticResource Muted}" Margin="0,6,0,12" FontSize="16"/>
            <TextBlock x:Name="LoginChoose" Tag="login.choose" FontWeight="SemiBold" Margin="0,4,0,6"/>
            <ComboBox x:Name="CmbLogin" Height="52" FontSize="18" VerticalContentAlignment="Center" Padding="12,0"/>
            <StackPanel x:Name="GuestNamePanel" Visibility="Collapsed" Margin="0,14,0,0">
              <TextBlock x:Name="GuestNameLabel" Tag="login.guestName" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <TextBox x:Name="TxtGuestName" MaxLength="254" FlowDirection="LeftToRight"/>
              <TextBlock x:Name="GuestEmailError" Tag="login.emailError" Foreground="{StaticResource C.Red.Fg}" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
            <TextBlock Tag="home.asset" FontWeight="SemiBold" Margin="0,16,0,6"/>
            <TextBox x:Name="TxtAsset" MaxLength="32" FlowDirection="LeftToRight"/>
            <TextBlock x:Name="AssetHint" Tag="home.assetOptional" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" Visibility="Collapsed"/>
            <Button x:Name="BtnStart" Style="{StaticResource Primary}" Tag="home.start" Margin="0,22,0,0" Height="64" FontSize="21"/>
            <TextBlock x:Name="HintFill" Tag="home.fillHint" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
              <Button x:Name="BtnStressOnly" Style="{StaticResource Link}" Tag="home.stressOnly"/>
              <Button x:Name="BtnHistory" Style="{StaticResource Link}" Tag="home.history" Margin="16,0,0,0"/>
              <Button x:Name="BtnAboutHome" Style="{StaticResource Link}" Tag="home.about" Margin="16,0,0,0"/>
              <Button x:Name="BtnSettings" Style="{StaticResource Link}" Tag="home.settings" Margin="16,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </StackPanel>
        </Border>
        </Grid>
        </ScrollViewer>
      </Grid>

      <!-- 2. Auto-check results (2.6.0, #9): summary chips, independent card heights, device details folded away -->
      <Grid x:Name="ScreenChecks" Visibility="Collapsed" Margin="16,16,16,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock Tag="checks.title" Style="{StaticResource H1}"/>
          <Border x:Name="DupBanner" Background="{StaticResource C.Amber.Fill}" CornerRadius="12" Padding="16,10" Margin="8,0,8,6" Visibility="Collapsed">
            <TextBlock x:Name="DupText" Foreground="{StaticResource C.Amber.Text}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          </Border>
          <UniformGrid Rows="1" Columns="4" Margin="4,0,4,4">
            <Button x:Name="ChipBat" Style="{StaticResource Flat}" Margin="4" Padding="12,8">
              <DockPanel>
                <Border x:Name="ChipBatBadge" DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" VerticalAlignment="Center"><TextBlock x:Name="ChipBatIcon" Foreground="{StaticResource C.White}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock x:Name="ChipBatBig" DockPanel.Dock="Right" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                <TextBlock Tag="battery.title" Margin="8,0" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </Button>
            <Button x:Name="ChipDisk" Style="{StaticResource Flat}" Margin="4" Padding="12,8">
              <DockPanel>
                <Border x:Name="ChipDiskBadge" DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" VerticalAlignment="Center"><TextBlock x:Name="ChipDiskIcon" Foreground="{StaticResource C.White}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock x:Name="ChipDiskBig" DockPanel.Dock="Right" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                <TextBlock Tag="disk.title" Margin="8,0" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </Button>
            <Button x:Name="ChipDrv" Style="{StaticResource Flat}" Margin="4" Padding="12,8">
              <DockPanel>
                <Border x:Name="ChipDrvBadge" DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" VerticalAlignment="Center"><TextBlock x:Name="ChipDrvIcon" Foreground="{StaticResource C.White}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock x:Name="ChipDrvBig" DockPanel.Dock="Right" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                <TextBlock Tag="drivers.title" Margin="8,0" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </Button>
            <Button x:Name="ChipUpd" Style="{StaticResource Flat}" Margin="4" Padding="12,8">
              <DockPanel>
                <Border x:Name="ChipUpdBadge" DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" VerticalAlignment="Center"><TextBlock x:Name="ChipUpdIcon" Foreground="{StaticResource C.White}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock x:Name="ChipUpdBig" DockPanel.Dock="Right" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                <TextBlock Tag="updates.title" Margin="8,0" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </Button>
          </UniformGrid>
        </StackPanel>
        <ScrollViewer x:Name="ChecksScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <Border x:Name="BatCard" Style="{StaticResource Card}" MinHeight="160">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top">
                      <TextBlock Tag="battery.title" Style="{StaticResource CardTitle}"/>
                      <Border x:Name="BatBadge" Style="{StaticResource Badge}"><TextBlock x:Name="BatIcon" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/></Border>
                    </Grid>
                    <TextBlock x:Name="BatBig" DockPanel.Dock="Top" FontSize="34" FontWeight="Bold" Margin="0,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="BatStatus" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <StackPanel x:Name="BatDetails"/>
                  </DockPanel>
                </Border>
                <Border x:Name="DrvCard" Style="{StaticResource Card}" MinHeight="160">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top">
                      <TextBlock Tag="drivers.title" Style="{StaticResource CardTitle}"/>
                      <Border x:Name="DrvBadge" Style="{StaticResource Badge}"><TextBlock x:Name="DrvIcon" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/></Border>
                    </Grid>
                    <TextBlock x:Name="DrvBig" DockPanel.Dock="Top" FontSize="34" FontWeight="Bold" Margin="0,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="DrvStatus" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <Button x:Name="DrvAction" DockPanel.Dock="Bottom" Style="{StaticResource Secondary}" Tag="drivers.openDevmgr" Height="40" FontSize="14" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    <StackPanel x:Name="DrvDetails"/>
                  </DockPanel>
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <Border x:Name="DiskCard" Style="{StaticResource Card}" MinHeight="160">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top">
                      <TextBlock Tag="disk.title" Style="{StaticResource CardTitle}"/>
                      <Border x:Name="DiskBadge" Style="{StaticResource Badge}"><TextBlock x:Name="DiskIcon" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/></Border>
                    </Grid>
                    <TextBlock x:Name="DiskBig" DockPanel.Dock="Top" FontSize="34" FontWeight="Bold" Margin="0,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="DiskStatus" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <StackPanel x:Name="DiskManualPanel" DockPanel.Dock="Bottom" Margin="0,8,0,0"/>
                    <StackPanel x:Name="DiskDetails"/>
                  </DockPanel>
                </Border>
                <Border x:Name="UpdCard" Style="{StaticResource Card}" MinHeight="160">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top">
                      <TextBlock Tag="updates.title" Style="{StaticResource CardTitle}"/>
                      <Border x:Name="UpdBadge" Style="{StaticResource Badge}"><TextBlock x:Name="UpdIcon" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/></Border>
                    </Grid>
                    <TextBlock x:Name="UpdBig" DockPanel.Dock="Top" FontSize="34" FontWeight="Bold" Margin="0,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="UpdStatus" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <Button x:Name="UpdAction" DockPanel.Dock="Bottom" Style="{StaticResource Secondary}" Tag="updates.open" Height="40" FontSize="14" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    <StackPanel x:Name="UpdDetails"/>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="DevCard" Grid.Column="0" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Tag="dev.title" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                    <StackPanel x:Name="DevDetails"/>
                  </StackPanel>
                </Border>
                <Border x:Name="MonCard" Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                  <StackPanel>
                    <TextBlock Tag="mon.title" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                    <TextBlock Tag="mon.cpu" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,2,0,10"><TextBlock x:Name="MonCpuText" DockPanel.Dock="Right" Width="150" Margin="8,0,0,0" FlowDirection="LeftToRight"/><ProgressBar x:Name="MonCpuBar" Height="14" Maximum="100"/></DockPanel>
                    <TextBlock Tag="mon.ram" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,2,0,10"><TextBlock x:Name="MonRamText" DockPanel.Dock="Right" Width="150" Margin="8,0,0,0" FlowDirection="LeftToRight"/><ProgressBar x:Name="MonRamBar" Height="14" Maximum="100"/></DockPanel>
                    <TextBlock Tag="mon.disk" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,2,0,0"><TextBlock x:Name="MonDiskText" DockPanel.Dock="Right" Width="150" Margin="8,0,0,0" FlowDirection="LeftToRight"/><ProgressBar x:Name="MonDiskBar" Height="14" Maximum="100"/></DockPanel>
                  </StackPanel>
                </Border>
              </Grid>
          </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="8,12,8,0">
          <Button x:Name="BtnChecksBack" DockPanel.Dock="Left" Style="{StaticResource Link}" Tag="common.back"/>
          <Button x:Name="BtnToStress" DockPanel.Dock="Right" Style="{StaticResource Primary}" Tag="checks.next"/>
          <Button x:Name="BtnRecheck" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Tag="common.recheck" Height="{DynamicResource PrimaryHeight}" Margin="0,0,12,0"/>
        </DockPanel>
      </Grid>

      <!-- 3. Stress tests (2.6.0, #10: the speaker test moved to the checklist) -->
      <Grid x:Name="ScreenStress" Visibility="Collapsed" Margin="16,16,16,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Tag="stress.title" Style="{StaticResource H1}"/>
        <Border Grid.Row="1" Background="{StaticResource C.Amber.Fill}" CornerRadius="12" Padding="16,10" Margin="8,0,8,6">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
              <TextBlock Tag="stress.duration" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
              <ComboBox x:Name="CmbDuration" Width="130" Height="38" FontSize="15" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Tag="stress.warn" TextWrapping="Wrap" Foreground="{StaticResource C.Amber.Text}"/>
              <TextBlock x:Name="MonStrip" FontWeight="SemiBold" Foreground="{StaticResource C.Text}" Margin="0,4,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel>

            <Border Style="{StaticResource Card}" Padding="18,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Tag="stress.cpu" FontSize="19" FontWeight="SemiBold"/>
                  <TextBlock Tag="stress.cpuDesc" Style="{StaticResource Muted}"/>
                  <ProgressBar x:Name="CpuProg" Margin="0,10,0,4"/>
                  <TextBlock x:Name="CpuLive" Style="{StaticResource Muted}" FontSize="13"/>
                </StackPanel>
                <Border x:Name="CpuPill" Grid.Column="1" Style="{StaticResource Pill}"><TextBlock x:Name="CpuPillText" FontWeight="SemiBold"/></Border>
                <Button x:Name="CpuStart" Grid.Column="2" Style="{StaticResource Secondary}" Tag="stress.start" Width="110" Height="46"/>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Tag="stress.ram" FontSize="19" FontWeight="SemiBold"/>
                  <TextBlock Tag="stress.ramDesc" Style="{StaticResource Muted}"/>
                  <ProgressBar x:Name="RamProg" Margin="0,10,0,4"/>
                  <TextBlock x:Name="RamLive" Style="{StaticResource Muted}" FontSize="13"/>
                </StackPanel>
                <Border x:Name="RamPill" Grid.Column="1" Style="{StaticResource Pill}"><TextBlock x:Name="RamPillText" FontWeight="SemiBold"/></Border>
                <Button x:Name="RamStart" Grid.Column="2" Style="{StaticResource Secondary}" Tag="stress.start" Width="110" Height="46"/>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Tag="stress.disk" FontSize="19" FontWeight="SemiBold"/>
                  <TextBlock Tag="stress.diskDesc" Style="{StaticResource Muted}"/>
                  <ProgressBar x:Name="DiskProg" Margin="0,10,0,4"/>
                  <TextBlock x:Name="DiskLive" Style="{StaticResource Muted}" FontSize="13"/>
                </StackPanel>
                <Border x:Name="DiskPill" Grid.Column="1" Style="{StaticResource Pill}"><TextBlock x:Name="DiskPillText" FontWeight="SemiBold"/></Border>
                <Button x:Name="DiskStart" Grid.Column="2" Style="{StaticResource Secondary}" Tag="stress.start" Width="110" Height="46"/>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Tag="stress.gpu" FontSize="19" FontWeight="SemiBold"/>
                  <TextBlock Tag="stress.gpuDesc" Style="{StaticResource Muted}"/>
                  <ProgressBar x:Name="GpuProg" Margin="0,10,0,4"/>
                  <TextBlock x:Name="GpuLive" Style="{StaticResource Muted}" FontSize="13"/>
                </StackPanel>
                <Border x:Name="GpuPill" Grid.Column="1" Style="{StaticResource Pill}"><TextBlock x:Name="GpuPillText" FontWeight="SemiBold"/></Border>
                <Button x:Name="GpuStart" Grid.Column="2" Style="{StaticResource Secondary}" Tag="stress.start" Width="110" Height="46"/>
              </Grid>
            </Border>

          </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="3" LastChildFill="False" Margin="8,12,8,0">
          <Button x:Name="BtnStressBack" DockPanel.Dock="Left" Style="{StaticResource Link}" Tag="common.back"/>
          <Button x:Name="BtnToReport" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Tag="stress.next" Height="{DynamicResource PrimaryHeight}"/>
          <Button x:Name="BtnStop" DockPanel.Dock="Right" Style="{StaticResource Danger}" Tag="stress.stop" Margin="0,0,12,0" Visibility="Collapsed"/>
          <Button x:Name="BtnRunAll" DockPanel.Dock="Right" Style="{StaticResource Primary}" Tag="stress.runAll" Margin="0,0,12,0"/>
        </DockPanel>
      </Grid>

      <!-- 3b. Manual checklist; rows are built in ManualTests.ps1 -->
      <Grid x:Name="ScreenManual" Visibility="Collapsed" Margin="16,16,16,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <DockPanel>
            <TextBlock x:Name="ManualCounter" DockPanel.Dock="Right" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"/>
            <TextBlock Tag="manual.title" Style="{StaticResource H1}"/>
          </DockPanel>
          <ProgressBar x:Name="ManualProgress" Height="6" Margin="8,0,8,8"/>
          <TextBlock Tag="manual.desc" Style="{StaticResource Muted}" Margin="8,0,8,2" FontSize="16"/>
          <TextBlock Tag="manual.keysHint" Style="{StaticResource Muted}" Margin="8,0,8,8" FontSize="13"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="ManualPanel"/>
        </ScrollViewer>
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="8,12,8,0">
          <Button x:Name="BtnManualBack" DockPanel.Dock="Left" Style="{StaticResource Link}" Tag="common.back"/>
          <Button x:Name="BtnManualNext" DockPanel.Dock="Right" Style="{StaticResource Primary}" Tag="manual.next"/>
        </DockPanel>
      </Grid>

      <!-- History (2.6.0, #11): filtered, sortable table read from index.csv in the background -->
      <Grid x:Name="ScreenHistory" Visibility="Collapsed" Margin="16,16,16,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Tag="history.title" Style="{StaticResource H1}"/>
        <Grid Grid.Row="1" Margin="8,0,8,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Tag="history.search" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBox x:Name="TxtHistorySearch" Grid.Row="1" Grid.Column="0" MaxLength="40" FlowDirection="LeftToRight"/>
          <ComboBox x:Name="CmbHistoryVerdict" Grid.Row="1" Grid.Column="1" Width="170" Height="46" FontSize="15" Margin="10,0,0,0" VerticalContentAlignment="Center"/>
          <ComboBox x:Name="CmbHistoryRange" Grid.Row="1" Grid.Column="2" Width="170" Height="46" FontSize="15" Margin="10,0,0,0" VerticalContentAlignment="Center"/>
          <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,6,0,0">
            <TextBlock x:Name="HistoryCount" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="13"/>
            <TextBlock Tag="history.hint" Style="{StaticResource Muted}" FontSize="13"/>
          </DockPanel>
        </Grid>
        <ListView x:Name="HistoryList" Grid.Row="2" Margin="8,0" BorderBrush="{StaticResource C.Line}" BorderThickness="2" FontSize="14"
                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" SelectionMode="Single">
          <ListView.View>
            <GridView>
              <GridViewColumn Width="125" DisplayMemberBinding="{Binding date}"/>
              <GridViewColumn Width="135" DisplayMemberBinding="{Binding who}"/>
              <GridViewColumn Width="90" DisplayMemberBinding="{Binding asset}"/>
              <GridViewColumn Width="145" DisplayMemberBinding="{Binding model}"/>
              <GridViewColumn Width="135" DisplayMemberBinding="{Binding serial}"/>
              <GridViewColumn Width="55" DisplayMemberBinding="{Binding grade}"/>
              <GridViewColumn Width="135">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="10" Padding="10,2" Background="{Binding vFill}">
                      <TextBlock Text="{Binding verdictText}" Foreground="{Binding vFg}" FontWeight="SemiBold"/>
                    </Border>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
        <DockPanel Grid.Row="3" LastChildFill="False" Margin="8,12,8,0">
          <Button x:Name="BtnHistoryBack" DockPanel.Dock="Left" Style="{StaticResource Link}" Tag="common.back"/>
          <Button x:Name="BtnHistoryOpen" DockPanel.Dock="Right" Style="{StaticResource Primary}" Tag="history.open"/>
          <Button x:Name="BtnHistoryFolder" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Tag="report.openFolder" Height="{DynamicResource PrimaryHeight}" Margin="0,0,12,0"/>
        </DockPanel>
      </Grid>

      <!-- 4. Report -->
      <Grid x:Name="ScreenReport" Visibility="Collapsed" Margin="16,16,16,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Tag="report.title" Style="{StaticResource H1}"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border x:Name="VerdictBox" CornerRadius="16" Padding="26,22" Margin="8" Background="{StaticResource C.Grey.Fill}">
              <DockPanel LastChildFill="True">
                <!-- grade tag (S / A+ / A / B) + score -->
                <Border x:Name="GradeTag" DockPanel.Dock="Right" CornerRadius="16" Padding="18,8" Margin="16,0,0,0" VerticalAlignment="Top" Background="{StaticResource C.Green.Fg}" Visibility="Collapsed">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="GradeTagText" FontSize="34" FontWeight="Bold" Foreground="{StaticResource C.White}" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
                    <TextBlock x:Name="GradeDescText" FontSize="13" Foreground="{StaticResource C.White}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="GradeScoreText" FontSize="12" Foreground="{StaticResource C.White}" HorizontalAlignment="Center" Opacity="0.9"/>
                  </StackPanel>
                </Border>
                <StackPanel>
                  <TextBlock x:Name="VerdictText" FontSize="32" FontWeight="Bold"/>
                  <StackPanel x:Name="VerdictReasons" Margin="0,10,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <!-- 2.7.0 (org feature "warranty"): rejected device -> return to warranty -->
            <Border x:Name="WarrantyBox" CornerRadius="14" Padding="22,14" Margin="8,0,8,8" Background="{StaticResource C.Reject}" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Tag="warranty.title" FontSize="20" FontWeight="Bold" Foreground="{StaticResource C.White}"/>
                <TextBlock x:Name="WarrantyText" FontSize="14" Foreground="{StaticResource C.White}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <!-- 2.9.0: sticker residue / scratches -> the technician decides (required before saving) -->
            <Border x:Name="CosmeticBox" Style="{StaticResource Card}" Background="{StaticResource C.Amber.Fill}" BorderBrush="{StaticResource C.Amber.Border}" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Tag="warranty.cosmeticQ" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource C.Amber.Text}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button x:Name="BtnCosReject" Style="{StaticResource Secondary}" Tag="warranty.cosmeticReject" Height="44" Padding="18,0" Margin="0,0,10,0"/>
                  <Button x:Name="BtnCosAccept" Style="{StaticResource Secondary}" Tag="warranty.cosmeticAccept" Height="44" Padding="18,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Tag="report.notes" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtNotes" MaxLength="2000" Height="96" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,8" VerticalScrollBarVisibility="Auto"/>
                <TextBlock x:Name="ReportError" Foreground="{StaticResource C.Red.Fg}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
            <Border x:Name="SavedBox" Style="{StaticResource Card}" Visibility="Collapsed" Background="{StaticResource C.Green.Fill}" BorderBrush="{StaticResource C.Green.Border}">
              <DockPanel>
                <Button x:Name="BtnOpenFolder" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Tag="report.openFolder" Height="40" FontSize="14" Margin="12,0,0,0"/>
                <TextBlock x:Name="SavedText" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <!-- 2.8.0 (org): Jira delivery status, always visible -->
            <Border x:Name="JiraBox" Style="{StaticResource Card}" Visibility="Collapsed">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="BtnJiraOpen" Style="{StaticResource Secondary}" Tag="jira.openIssue" Height="40" FontSize="14" Margin="8,0,0,0" Visibility="Collapsed"/>
                  <Button x:Name="BtnJiraRetry" Style="{StaticResource Secondary}" Tag="jira.retry" Height="40" FontSize="14" Margin="8,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Tag="jira.status" FontSize="13" FontWeight="SemiBold" Style="{StaticResource Muted}"/>
                  <TextBlock x:Name="JiraStateText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  <TextBlock x:Name="JiraDetail" FontSize="13" Style="{StaticResource Muted}" Margin="0,2,0,0" Visibility="Collapsed"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <!-- 2.6.0 (#6): after saving, "Next device" is the primary action; Save becomes "Saved" / "Update report". -->
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="8,12,8,0">
          <Button x:Name="BtnReportBack" DockPanel.Dock="Left" Style="{StaticResource Link}" Tag="common.back"/>
          <Button x:Name="BtnNew" DockPanel.Dock="Right" Style="{StaticResource Primary}" Tag="report.new" Visibility="Collapsed"/>
          <Button x:Name="BtnSave" DockPanel.Dock="Right" Style="{StaticResource Primary}" Tag="report.save" Margin="0,0,12,0"/>
          <Button x:Name="BtnPrintSummary" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Tag="report.printSummary" Height="{DynamicResource PrimaryHeight}" Margin="0,0,12,0" Visibility="Collapsed"/>
          <Button x:Name="BtnCopy" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Tag="report.copy" Height="{DynamicResource PrimaryHeight}" Margin="0,0,12,0"/>
          <Button x:Name="BtnJira" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Tag="jira.send" Height="{DynamicResource PrimaryHeight}" Margin="0,0,12,0" Visibility="Collapsed"/>
        </DockPanel>
      </Grid>

      <!-- 2.8.0 Settings (org flag "settings"): failure limits stored in config\settings.json -->
      <Grid x:Name="ScreenSettings" Visibility="Collapsed" Margin="16,16,16,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Tag="settings.title" Style="{StaticResource H1}"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <Border Style="{StaticResource Card}" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel>
              <TextBlock Tag="settings.desc" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
              <TextBlock Tag="settings.battery" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <DockPanel><TextBlock x:Name="SetBatteryDefault" Style="{StaticResource Muted}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0"/><TextBox x:Name="TxtSetBattery" Width="140" HorizontalAlignment="Left" FlowDirection="LeftToRight" MaxLength="3"/></DockPanel>
              <TextBlock Tag="settings.disk" FontWeight="SemiBold" Margin="0,16,0,6"/>
              <DockPanel><TextBlock x:Name="SetDiskDefault" Style="{StaticResource Muted}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0"/><TextBox x:Name="TxtSetDisk" Width="140" HorizontalAlignment="Left" FlowDirection="LeftToRight" MaxLength="3"/></DockPanel>
              <TextBlock Tag="settings.cycles" FontWeight="SemiBold" Margin="0,16,0,6"/>
              <DockPanel><TextBlock x:Name="SetCyclesDefault" Style="{StaticResource Muted}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0"/><TextBox x:Name="TxtSetCycles" Width="140" HorizontalAlignment="Left" FlowDirection="LeftToRight" MaxLength="4"/></DockPanel>
              <TextBlock Tag="settings.cyclesHint" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/>
              <TextBlock x:Name="SettingsMsg" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
          </Border>
        </ScrollViewer>
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="8,12,8,0">
          <Button x:Name="BtnSettingsBack" DockPanel.Dock="Left" Style="{StaticResource Link}" Tag="common.back"/>
          <Button x:Name="BtnSettingsSave" DockPanel.Dock="Right" Style="{StaticResource Primary}" Tag="settings.save"/>
          <Button x:Name="BtnSettingsReset" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Tag="settings.reset" Height="{DynamicResource PrimaryHeight}" Margin="0,0,12,0"/>
        </DockPanel>
      </Grid>

      <!-- About: org-only sections are hidden by edition flags (Ui.ps1 Update-WkAbout) -->
      <Grid x:Name="ScreenAbout" Visibility="Collapsed" Margin="16,16,16,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Tag="about.title" Style="{StaticResource H1}"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <Image x:Name="AboutDokiImg" DockPanel.Dock="Left" Width="128" Height="128" Margin="0,0,20,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Doki" FontSize="30" FontWeight="Bold" Foreground="{StaticResource C.Teal}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                  <TextBlock Tag="doki.aboutTitle" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
                  <TextBlock x:Name="AboutVersion" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
                  <TextBlock x:Name="AboutBuild" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                  <TextBlock Tag="about.madeFor" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                  <TextBlock x:Name="AboutCredit" Tag="about.credit" FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border x:Name="AboutProjectCard" Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel x:Name="AboutGitHubPanel">
                  <TextBlock Tag="about.project" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                  <Button x:Name="BtnGitHub" Style="{StaticResource Link}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel x:Name="AboutUpdatePanel">
                  <TextBlock Tag="update.title" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,6"/>
                  <TextBlock x:Name="AboutUpdateStatus" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="BtnUpdateCheck" Style="{StaticResource Secondary}" Tag="update.check" Height="40" FontSize="14"/>
                    <Button x:Name="BtnUpdateInstall" Style="{StaticResource Primary}" Tag="update.install" Height="40" FontSize="14" Margin="8,0,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border x:Name="AboutContactCard" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Tag="about.contact" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Tag="about.qcOwner" VerticalAlignment="Center" Width="190"/>
                  <Button x:Name="AboutMailQc" Style="{StaticResource Link}" FlowDirection="LeftToRight"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Tag="about.support" VerticalAlignment="Center" Width="190"/>
                  <Button x:Name="AboutMailSupport" Style="{StaticResource Link}" FlowDirection="LeftToRight"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border x:Name="AboutJiraCard" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Tag="about.jira" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="AboutJiraStatus" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button x:Name="BtnJiraTest" Style="{StaticResource Secondary}" Tag="jira.test" Height="40" FontSize="14"/>
                  <TextBlock x:Name="AboutJiraResult" VerticalAlignment="Center" Margin="12,0" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Tag="about.sounds" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="AboutSoundsHint" Style="{StaticResource Muted}"/>
                <StackPanel x:Name="AboutSounds" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Tag="about.config" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="AboutConfig" Style="{StaticResource Muted}" FlowDirection="LeftToRight" TextAlignment="Left"/>
                <TextBlock Tag="about.reports" FontWeight="SemiBold" Margin="0,10,0,4"/>
                <TextBlock x:Name="AboutReports" Style="{StaticResource Muted}" FlowDirection="LeftToRight" TextAlignment="Left"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="8,12,8,0">
          <Button x:Name="BtnAboutBack" DockPanel.Dock="Left" Style="{StaticResource Link}" Tag="common.back"/>
        </DockPanel>
      </Grid>

    </Grid>
    </Grid>

    <!-- 2.8.0 Finish window content (org flag "finishWindow"). Ui.ps1 moves FinishRoot into its own window after the first save;
         it holds the device preparation and follow-up cards so their existing code keeps working. -->
    <Grid x:Name="FinishHolder" Grid.Row="3" Visibility="Collapsed">
      <Grid x:Name="FinishRoot" Background="{StaticResource C.Bg}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="24,20,24,8">
          <TextBlock Tag="finish.title" FontSize="26" FontWeight="Bold" Foreground="{StaticResource C.Green.Fg}"/>
          <TextBlock Tag="finish.desc" Style="{StaticResource Muted}" FontSize="15" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <Border x:Name="FinGradeTag" DockPanel.Dock="Right" CornerRadius="12" Padding="14,4" VerticalAlignment="Top" Background="{StaticResource C.Green.Fg}">
                    <TextBlock x:Name="FinGradeText" FontSize="24" FontWeight="Bold" Foreground="{StaticResource C.White}" FlowDirection="LeftToRight"/>
                  </Border>
                  <StackPanel>
                    <TextBlock Tag="finish.report" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FinVerdict" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </DockPanel>
                <Border x:Name="FinWarrantyBox" CornerRadius="10" Padding="14,8" Margin="0,10,0,0" Background="{StaticResource C.Reject}" Visibility="Collapsed">
                  <TextBlock x:Name="FinWarrantyText" Foreground="{StaticResource C.White}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>
                <TextBlock x:Name="FinPath" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,8" FlowDirection="LeftToRight" TextAlignment="Left" TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button x:Name="BtnFinOpenReport" Style="{StaticResource Secondary}" Tag="finish.openReport" Height="40" FontSize="14" Margin="0,0,8,6"/>
                  <Button x:Name="BtnFinOpenFolder" Style="{StaticResource Secondary}" Tag="report.openFolder" Height="40" FontSize="14" Margin="0,0,8,6"/>
                  <Button x:Name="BtnFinPrintSummary" Style="{StaticResource Primary}" Tag="report.printSummary" Height="40" FontSize="14" Margin="0,0,8,6" Visibility="Collapsed"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border x:Name="FinJiraBox" Style="{StaticResource Card}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="BtnFinJiraOpen" Style="{StaticResource Secondary}" Tag="jira.openIssue" Height="40" FontSize="14" Margin="8,0,0,0" Visibility="Collapsed"/>
                  <Button x:Name="BtnFinJiraRetry" Style="{StaticResource Secondary}" Tag="jira.retry" Height="40" FontSize="14" Margin="8,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Tag="jira.status" FontSize="13" FontWeight="SemiBold" Style="{StaticResource Muted}"/>
                  <TextBlock x:Name="FinJiraStateText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  <TextBlock x:Name="FinJiraDetail" FontSize="13" Style="{StaticResource Muted}" Margin="0,2,0,0" Visibility="Collapsed"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border x:Name="DeployCard" Style="{StaticResource Card}" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Tag="dep.title" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Tag="dep.desc" Style="{StaticResource Muted}" Margin="0,4,0,10"/>
                <Border x:Name="DepDryBox" Background="{StaticResource C.Amber.Fill}" CornerRadius="10" Padding="12,6" Margin="0,0,0,10" Visibility="Collapsed">
                  <TextBlock Tag="dep.dryRun" Foreground="{StaticResource C.Amber.Text}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Tag="dep.prefix" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                  <ComboBox x:Name="CmbPrefix" Width="110" Height="40" FontSize="16" VerticalContentAlignment="Center"/>
                  <TextBlock x:Name="DepNewName" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" Margin="16,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="DepCurrent" Style="{StaticResource Muted}" Margin="0,6,0,10"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="BtnRename" Style="{StaticResource Secondary}" Tag="dep.rename" Height="46" Margin="0,0,10,0"/>
                  <Button x:Name="BtnInstallEdr" Style="{StaticResource Secondary}" Tag="dep.install" Height="46" Margin="0,0,10,0"/>
                  <Button x:Name="BtnRestart" Style="{StaticResource Secondary}" Tag="dep.restart" Height="46"/>
                </StackPanel>
                <StackPanel x:Name="DepStatus" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
            <Border x:Name="FollowCard" Style="{StaticResource Card}" Visibility="Collapsed" BorderBrush="{StaticResource C.TealLine}">
              <DockPanel>
                <Image x:Name="FollowDokiImg" DockPanel.Dock="Left" Width="64" Height="64" Margin="0,0,14,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel>
                  <TextBlock x:Name="FollowQ" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <StackPanel x:Name="FollowButtons" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnFollowYes" Style="{StaticResource Primary}" Tag="follow.yes" Height="44" FontSize="16" Padding="28,0" Margin="0,0,10,0"/>
                    <Button x:Name="BtnFollowNo" Style="{StaticResource Secondary}" Tag="follow.no" Height="44" Padding="28,0"/>
                  </StackPanel>
                  <TextBlock x:Name="FollowInfo" Style="{StaticResource Muted}" FontSize="15" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="20,10,20,16">
          <Button x:Name="BtnFinBack" DockPanel.Dock="Left" Style="{StaticResource Secondary}" Tag="finish.back" Height="52"/>
          <Button x:Name="BtnFinNext" DockPanel.Dock="Right" Style="{StaticResource Primary}" Tag="finish.next"/>
        </DockPanel>
      </Grid>
    </Grid>

    <!-- Footer (standalone edition): creator credit at the bottom-left in both languages. -->
    <Border x:Name="FooterBar" Grid.Row="4" Background="{StaticResource C.Surface}" BorderBrush="{StaticResource C.Line}" BorderThickness="0,1,0,0" Padding="16,4" Visibility="Collapsed">
      <Grid FlowDirection="LeftToRight">
        <TextBlock x:Name="FooterCredit" Tag="about.credit" FontSize="12" Foreground="{StaticResource C.Muted}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBlock x:Name="FooterVersion" FontSize="12" Foreground="{StaticResource C.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
